<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ferramenta de Análise Estatística</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
        }

        /* Menu Lateral */
        .sidebar {
            width: 70px;
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border-right: 1px solid rgba(255, 255, 255, 0.2);
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 20px 0;
            transition: all 0.3s ease;
        }

        .sidebar-item {
            position: relative;
            margin: 15px 0;
            padding: 15px;
            border-radius: 12px;
            cursor: pointer;
            transition: all 0.3s ease;
            color: white;
        }

        .sidebar-item:hover {
            background: rgba(255, 255, 255, 0.2);
            transform: translateX(5px);
        }

        .sidebar-item svg {
            width: 24px;
            height: 24px;
        }

        .tooltip {
            position: absolute;
            left: 70px;
            top: 50%;
            transform: translateY(-50%);
            background: rgba(0, 0, 0, 0.8);
            color: white;
            padding: 8px 12px;
            border-radius: 6px;
            font-size: 14px;
            white-space: nowrap;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s ease;
            z-index: 1000;
        }

        .sidebar-item:hover .tooltip {
            opacity: 1;
            visibility: visible;
        }

        /* Conteúdo Principal */
        .main-content {
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        /* Menu Superior */
        .top-menu {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.2);
            padding: 15px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .search-bar {
            flex: 1;
            max-width: 400px;
            margin: 0 30px;
        }

        .search-input {
            width: 100%;
            padding: 12px 20px;
            border: none;
            border-radius: 25px;
            background: rgba(255, 255, 255, 0.2);
            color: white;
            font-size: 16px;
            outline: none;
            transition: all 0.3s ease;
        }

        .search-input::placeholder {
            color: rgba(255, 255, 255, 0.7);
        }

        .search-input:focus {
            background: rgba(255, 255, 255, 0.3);
            transform: scale(1.02);
        }

        .user-info {
            display: flex;
            align-items: center;
            color: white;
        }

        .user-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            margin-right: 12px;
            border: 2px solid rgba(255, 255, 255, 0.3);
        }

        .user-name {
            font-weight: 600;
            font-size: 16px;
        }

        /* Área Principal */
        .content-area {
            flex: 1;
            padding: 30px;
            overflow-y: auto;
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
            background: rgba(255, 255, 255, 0.95);
            border-radius: 20px;
            padding: 40px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
        }

        .title {
            font-size: 2.5rem;
            color: #333;
            text-align: center;
            margin-bottom: 10px;
            font-weight: 700;
        }

        .description {
            font-size: 1.1rem;
            color: #666;
            text-align: center;
            margin-bottom: 40px;
            line-height: 1.6;
        }

        .inputs-section {
            margin-bottom: 40px;
        }

        .input-group {
            margin-bottom: 25px;
        }

        .input-label {
            display: block;
            font-size: 1rem;
            font-weight: 600;
            color: #333;
            margin-bottom: 8px;
        }

        .input-field {
            width: 100%;
            padding: 18px 25px;
            border: 2px solid #e1e5e9;
            border-radius: 50px;
            font-size: 1.1rem;
            outline: none;
            transition: all 0.3s ease;
            background: #f8f9fa;
        }

        .input-field:focus {
            border-color: #667eea;
            background: white;
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(102, 126, 234, 0.15);
        }

        .results-section {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            margin-bottom: 40px;
        }

        .result-card {
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
            padding: 25px;
            border-radius: 15px;
            text-align: center;
            transform: translateY(10px);
            opacity: 0;
            transition: all 0.5s ease;
        }

        .result-card.show {
            transform: translateY(0);
            opacity: 1;
        }

        .result-label {
            font-size: 0.9rem;
            opacity: 0.9;
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .result-value {
            font-size: 2rem;
            font-weight: 700;
        }

        .code-section {
            background: #1a1a1a;
            border-radius: 15px;
            padding: 25px;
            margin-top: 30px;
            opacity: 0;
            transform: translateY(20px);
            transition: all 0.5s ease;
        }

        .code-section.show {
            opacity: 1;
            transform: translateY(0);
        }

        .code-title {
            color: #fff;
            font-size: 1.2rem;
            margin-bottom: 15px;
            font-weight: 600;
        }

        .code-content {
            color: #a8e6cf;
            font-family: 'Courier New', monospace;
            font-size: 0.9rem;
            line-height: 1.6;
            white-space: pre-wrap;
        }

        @media (max-width: 768px) {
            .sidebar {
                width: 60px;
            }
            
            .top-menu {
                padding: 10px 15px;
            }
            
            .search-bar {
                margin: 0 15px;
            }
            
            .content-area {
                padding: 15px;
            }
            
            .container {
                padding: 25px;
            }
            
            .title {
                font-size: 2rem;
            }
        }
    </style>
</head>
<body>
    <!-- Menu Lateral -->
    <div class="sidebar">
        <div class="sidebar-item">
            <svg fill="currentColor" viewBox="0 0 20 20">
                <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"/>
            </svg>
            <div class="tooltip">Home</div>
        </div>
        <div class="sidebar-item">
            <svg fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M11.49 3.17c-.38-1.56-2.6-1.56-2.98 0a1.532 1.532 0 01-2.286.948c-1.372-.836-2.942.734-2.106 2.106.54.886.061 2.042-.947 2.287-1.561.379-1.561 2.6 0 2.978a1.532 1.532 0 01.947 2.287c-.836 1.372.734 2.942 2.106 2.106a1.532 1.532 0 012.287.947c.379 1.561 2.6 1.561 2.978 0a1.533 1.533 0 012.287-.947c1.372.836 2.942-.734 2.106-2.106a1.533 1.533 0 01.947-2.287c1.561-.379 1.561-2.6 0-2.978a1.532 1.532 0 01-.947-2.287c.836-1.372-.734-2.942-2.106-2.106a1.532 1.532 0 01-2.287-.947zM10 13a3 3 0 100-6 3 3 0 000 6z" clip-rule="evenodd"/>
            </svg>
            <div class="tooltip">Configurações</div>
        </div>
    </div>

    <!-- Conteúdo Principal -->
    <div class="main-content">
        <!-- Menu Superior -->
        <div class="top-menu">
            <div class="search-bar">
                <input type="text" class="search-input" placeholder="Pesquisar...">
            </div>
            <div class="user-info">
                <img src="/placeholder.svg?height=40&width=40" alt="Avatar" class="user-avatar">
                <span class="user-name">João Silva</span>
            </div>
        </div>

        <!-- Área de Conteúdo -->
        <div class="content-area">
            <div class="container">
                <h1 class="title">Análise Estatística</h1>
                <p class="description">
                    Digite três valores numéricos nos campos abaixo e veja automaticamente o cálculo da média, mediana e moda dos valores inseridos.
                </p>

                <div class="inputs-section">
                    <div class="input-group">
                        <label class="input-label">Primeiro Valor</label>
                        <input type="text" class="input-field" id="valor1" placeholder="Digite o primeiro valor">
                    </div>
                    <div class="input-group">
                        <label class="input-label">Segundo Valor</label>
                        <input type="text" class="input-field" id="valor2" placeholder="Digite o segundo valor">
                    </div>
                    <div class="input-group">
                        <label class="input-label">Terceiro Valor</label>
                        <input type="text" class="input-field" id="valor3" placeholder="Digite o terceiro valor">
                    </div>
                </div>

                <div class="results-section">
                    <div class="result-card" id="mediaCard">
                        <div class="result-label">Média</div>
                        <div class="result-value" id="mediaValue">-</div>
                    </div>
                    <div class="result-card" id="medianaCard">
                        <div class="result-label">Mediana</div>
                        <div class="result-value" id="medianaValue">-</div>
                    </div>
                    <div class="result-card" id="modaCard">
                        <div class="result-label">Moda</div>
                        <div class="result-value" id="modaValue">-</div>
                    </div>
                </div>

                <div class="code-section" id="codeSection">
                    <div class="code-title">Código JavaScript Utilizado:</div>
                    <div class="code-content" id="codeContent"></div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Função para validar se todos os inputs estão preenchidos com números
        function validarInputs() {
            const valor1 = document.getElementById('valor1').value.trim();
            const valor2 = document.getElementById('valor2').value.trim();
            const valor3 = document.getElementById('valor3').value.trim();

            // Verifica se todos os campos estão preenchidos
            if (valor1 === '' || valor2 === '' || valor3 === '') {
                return false;
            }

            // Verifica se todos os valores são números válidos
            const num1 = parseFloat(valor1);
            const num2 = parseFloat(valor2);
            const num3 = parseFloat(valor3);

            return !isNaN(num1) && !isNaN(num2) && !isNaN(num3);
        }

        // Função para calcular a média
        function calcularMedia(valores) {
            const soma = valores.reduce((acc, val) => acc + val, 0);
            return soma / valores.length;
        }

        // Função para calcular a mediana
        function calcularMediana(valores) {
            const valoresOrdenados = [...valores].sort((a, b) => a - b);
            const meio = Math.floor(valoresOrdenados.length / 2);
            
            if (valoresOrdenados.length % 2 === 0) {
                return (valoresOrdenados[meio - 1] + valoresOrdenados[meio]) / 2;
            } else {
                return valoresOrdenados[meio];
            }
        }

        // Função para calcular a moda
        function calcularModa(valores) {
            const frequencia = {};
            let maxFreq = 0;
            let moda = [];

            // Conta a frequência de cada valor
            valores.forEach(valor => {
                frequencia[valor] = (frequencia[valor] || 0) + 1;
                if (frequencia[valor] > maxFreq) {
                    maxFreq = frequencia[valor];
                }
            });

            // Encontra todos os valores com frequência máxima
            for (let valor in frequencia) {
                if (frequencia[valor] === maxFreq) {
                    moda.push(parseFloat(valor));
                }
            }

            // Se todos os valores têm a mesma frequência, não há moda
            if (moda.length === valores.length) {
                return "Sem moda";
            }

            return moda.length === 1 ? moda[0] : moda.join(', ');
        }

        // Função principal que processa os valores
        function processarValores() {
            if (!validarInputs()) {
                // Esconde os resultados se a validação falhar
                document.querySelectorAll('.result-card').forEach(card => {
                    card.classList.remove('show');
                });
                document.getElementById('codeSection').classList.remove('show');
                return;
            }

            // Obtém os valores dos inputs
            const valor1 = parseFloat(document.getElementById('valor1').value);
            const valor2 = parseFloat(document.getElementById('valor2').value);
            const valor3 = parseFloat(document.getElementById('valor3').value);
            const valores = [valor1, valor2, valor3];

            // Calcula as estatísticas
            const media = calcularMedia(valores);
            const mediana = calcularMediana(valores);
            const moda = calcularModa(valores);

            // Atualiza os resultados na tela
            document.getElementById('mediaValue').textContent = media.toFixed(2);
            document.getElementById('medianaValue').textContent = mediana.toFixed(2);
            document.getElementById('modaValue').textContent = moda;

            // Mostra os cards de resultado com animação
            setTimeout(() => {
                document.getElementById('mediaCard').classList.add('show');
            }, 100);
            setTimeout(() => {
                document.getElementById('medianaCard').classList.add('show');
            }, 200);
            setTimeout(() => {
                document.getElementById('modaCard').classList.add('show');
            }, 300);

            // Mostra o código utilizado
            const codigoUtilizado = `
// Valores inseridos: [${valores.join(', ')}]

// Cálculo da Média:
const soma = ${valores.join(' + ')} = ${valores.reduce((a, b) => a + b, 0)};
const media = soma / ${valores.length} = ${media.toFixed(2)};

// Cálculo da Mediana:
const valoresOrdenados = [${[...valores].sort((a, b) => a - b).join(', ')}];
const mediana = ${mediana.toFixed(2)};

// Cálculo da Moda:
const frequencias = {${valores.map(v => `${v}: ${valores.filter(x => x === v).length}`).join(', ')}};
const moda = ${moda};`;

            document.getElementById('codeContent').textContent = codigoUtilizado;
            
            setTimeout(() => {
                document.getElementById('codeSection').classList.add('show');
            }, 400);
        }

        // Adiciona event listeners para os inputs
        document.getElementById('valor1').addEventListener('input', processarValores);
        document.getElementById('valor2').addEventListener('input', processarValores);
        document.getElementById('valor3').addEventListener('input', processarValores);

        // Adiciona efeito de foco nos inputs
        document.querySelectorAll('.input-field').forEach(input => {
            input.addEventListener('focus', function() {
                this.parentElement.style.transform = 'scale(1.02)';
            });
            
            input.addEventListener('blur', function() {
                this.parentElement.style.transform = 'scale(1)';
            });
        });
    </script>
</body>
</html>
