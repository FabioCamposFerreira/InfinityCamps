---
import Button from './ui/Button.astro';
---

<div id="chapter-toolbar" class="chapter-toolbar" role="group" aria-label="Navegação do capítulo" hidden>
  <div class="chapter-toolbar-info">
    <p id="chapter-position" class="chapter-position" aria-live="polite">Capítulo —</p>
    <p id="slide-position" class="chapter-slide-position" aria-live="polite" hidden></p>
  </div>
  <div class="chapter-toolbar-actions">
    <Button id="btn-prev" variant="ghost" class="chapter-toolbar-prev" disabled>← Anterior</Button>
    <Button id="btn-mark" variant="primary" class="chapter-toolbar-mark">Marcar Concluído</Button>
    <Button id="btn-next" variant="ghost" class="chapter-toolbar-next" disabled>Próximo →</Button>
  </div>
</div>

<style>
  .chapter-toolbar {
    position: sticky;
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 32px;
    padding: 12px 16px;
    background: color-mix(in srgb, var(--surface, #1e293b) 92%, transparent);
    backdrop-filter: blur(8px);
    border: 1px solid var(--card-border, #334155);
    border-radius: var(--border-radius, 0.5rem);
    box-shadow: var(--shadow);
    z-index: 40;
  }

  .chapter-toolbar[hidden] {
    display: none;
  }

  .chapter-toolbar-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .chapter-slide-position {
    margin: 0;
    font-size: 12px;
    color: var(--muted, #94a3b8);
    font-variant-numeric: tabular-nums;
  }

  .chapter-position {
    margin: 0;
    font-size: 13px;
    color: var(--muted, #94a3b8);
    white-space: nowrap;
  }

  .chapter-toolbar-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* Os botões são renderizados pelo Button (outro escopo), por isso :global(). */
  :global(.chapter-toolbar .btn) {
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .chapter-toolbar {
      flex-direction: column;
      align-items: stretch;
      gap: 8px;
    }

    .chapter-position {
      text-align: center;
    }

    :global(.chapter-toolbar .btn) {
      flex: 1;
      padding-inline: 8px;
      font-size: 13px;
    }
  }
</style>
