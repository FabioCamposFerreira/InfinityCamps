---
type Variant = 'primary' | 'secondary' | 'ghost' | 'danger';
type Size = 'sm' | 'md' | 'lg';

interface Props {
  variant?: Variant;
  size?: Size;
  disabled?: boolean;
  hidden?: boolean;
  type?: 'button' | 'submit' | 'reset';
  onClick?: string;
  class?: string;
  id?: string;
  ariaLabel?: string;
  ariaPressed?: boolean;
  ariaControls?: string;
}

const {
  variant = 'primary',
  size = 'md',
  disabled = false,
  hidden = false,
  type = 'button',
  onClick,
  class: extraClass = '',
  id,
  ariaLabel,
  ariaPressed,
  ariaControls,
} = Astro.props;

const baseClass = 'btn';
const variantClass = `btn-${variant}`;
const sizeClass = `btn-${size}`;
const classes = [baseClass, variantClass, sizeClass, extraClass].filter(Boolean).join(' ');
---

<button
  id={id}
  class={classes}
  type={type}
  disabled={disabled}
  hidden={hidden}
  onClick={onClick}
  aria-label={ariaLabel}
  aria-pressed={ariaPressed}
  aria-controls={ariaControls}
>
  <slot />
</button>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 8px 16px;
    border: none;
    border-radius: 4px;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
    text-decoration: none;
  }

  .btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  /* Variants */
  .btn-primary {
    background: var(--accent, #0066cc);
    color: white;
  }

  .btn-primary:hover:not(:disabled) {
    background: var(--accent-hover, #0052a3);
  }

  .btn-secondary {
    background: var(--surface, #fff);
    color: var(--ink, #1d3557);
    border: 1px solid var(--border, #e0e0e0);
  }

  .btn-secondary:hover:not(:disabled) {
    background: var(--surface-hover, #f5f5f5);
  }

  .btn-ghost {
    background: transparent;
    color: var(--ink, #1d3557);
  }

  .btn-ghost:hover:not(:disabled) {
    background: var(--surface-hover, #f5f5f5);
  }

  .btn-danger {
    background: #dc3545;
    color: white;
  }

  .btn-danger:hover:not(:disabled) {
    background: #c82333;
  }

  /* Sizes */
  .btn-sm {
    padding: 4px 12px;
    font-size: 12px;
  }

  .btn-md {
    padding: 8px 16px;
    font-size: 14px;
  }

  .btn-lg {
    padding: 12px 24px;
    font-size: 16px;
  }
</style>
